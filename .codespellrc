# codespell configuration (used locally and by .github/workflows/lint.yml)
# The ignore list keeps vendored upstream-derived code (engine/rvc) and the
# web UI's variable naming from producing false positives.
[codespell]
ignore-words-list = ontext,thred,devided,allready,padd,threhold
skip = ./.git,./.venv,./dist,./site,./uv.lock,./logs,./runs,./models,./assets,./data,./.codespellrc
count = false
quiet-level = 2
