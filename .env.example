# ============================================================================
# 1) نموذج HuggingFace الافتراضي (الصوت العراقي)
# ============================================================================
# معرف المستودع (يدعم المستودعات الخاصة عند توفير التوكن)
RVC_HF_REPO=eng7mi/Iraqi-v3

# توكن الوصول من HuggingFace — مطلوب للمستودعات الخاصة، ويُستخدم أيضًا
# لنشر نتائج التدريب من نفس الجلسة.
# أنشئه من: https://huggingface.co/settings/tokens (صلاحية read، مع write إن أردت النشر)
RVC_HF_TOKEN=

# توكن بديل: إن تُرك RVC_HF_TOKEN فارغًا يبحث النظام تلقائيًا عن HF_TOKEN
# ثم HUGGINGFACE_HUB_TOKEN (الاصطلاح القياسي لأدوات HF).
#HF_TOKEN=
#HUGGINGFACE_HUB_TOKEN=

# رابط التنزيل الأساسي (اختياري — يُبنى تلقائيًا من RVC_HF_REPO إن تُرك فارغًا)
# مفيد للتوجيه إلى مرآة بديلة أو نشر self-hosted
#RVC_HF_MODEL_URL=

# مسارات الملفات داخل المستودع (افتراضيات best/ لخط Iraqi-v3)
RVC_HF_MODEL_FILE=best/model.pth
RVC_HF_INDEX_FILE=best/index.index

# اسم النموذج المسجّل محليًا داخل models/
RVC_HF_LOCAL_NAME=iraqi_voice

# تنزيل تلقائي عند الإقلاع / تحميل تلقائي كنموذج افتراضي في المحرك
RVC_HF_AUTO_DOWNLOAD=true
RVC_HF_AUTO_LOAD=true


# ============================================================================
# 2) الخادم والأمان
# ============================================================================
# عنوان الاستماع — 127.0.0.1 (محلي فقط) هو الافتراضي الآمن.
# استخدم 0.0.0.0 فقط خلف نفق أو على Colab أو لشبكة محلية موثوقة.
#RVC_SERVER_HOST=127.0.0.1

# منفذ الخادم (1024..65535) — الافتراضي 8320
#RVC_SERVER_PORT=8320

# تفعيل مصادقة API بتوكن Bearer — الافتراضي false.
# ملاحظة: تُفعَّل المصادقة تلقائيًا عند بدء النفق مهما كانت هذه القيمة.
#RVC_AUTH_ENABLED=false

# التوكن السري (طويل وعشوائي). إن تُرك فارغًا مع تفعيل المصادقة:
# يُولَّد توكن جديد عند الإقلاع ويُطبع في الطرفية ويُكتب في logs/auth.token
#RVC_AUTH_TOKEN=


# ============================================================================
# 3) المحرك (الاستدلال)
# ============================================================================
# جهاز الاستدلال: auto (يكشف CUDA تلقائيًا) | cpu | cuda:0 ...
#RVC_DEVICE=auto

# مستخرج النغمة الافتراضي: rmvpe (الأدق) | fcpe (الأسرع) | pm (خفيف للـCPU)
#RVC_F0_METHOD=rmvpe

# إجبار تحميل/معالجة الصوت (ffmpeg/torchaudio) على CPU — مفيد عند تضارب
# ترميزات الصوت مع GPU (1 = تفعيل، 0 = افتراضي)
#RVC_AUDIO_FORCE_CPU=0

# مسار CUDA Graph (التقاط/إعادة تشغيل لتسريع الاستدلال — CUDA فقط):
#   1 = فرض التفعيل، 0 = فرض التعطيل، فارغ = فحص تلقائي عند الإقلاع
#RVC_CUDA_GRAPH=1

# عدد رسوم CUDA Graph المحتفظ بها في الذاكرة (افتراضي 8)
#RVC_CUDA_GRAPH_MAX_CACHE=8


# ============================================================================
# 4) البث اللحظي (Realtime)
# ============================================================================
# حجم كتلة البث بالمللي ثانية (60..500) — الافتراضي 160.
# قلّله لزمن استجابة أقل على GPU قوي، وزده على GPU أضعف.
#RVC_BLOCK_MS=160


# ============================================================================
# 5) التدريب
# ============================================================================
# معدل العينات الافتراضي للتدريب: 32k | 40k | 48k
#RVC_TRAIN_SR=40k


# ============================================================================
# 6) أداء التدريب (DataLoader / compile)
# ============================================================================
# عدد عمال DataLoader (0..16). الافتراضي: تلقائي — min(6, max(2, عدد الأنوية))
# على CUDA و0 على CPU. العودة للسلوك القديم: RVC_NUM_WORKERS=2
#RVC_NUM_WORKERS=

# إبقاء العمال أحياء بين الحقب (1 = مفعّل افتراضيًا، 0 = إعادة fork كل epoch)
#RVC_PERSISTENT_WORKERS=1

# عامل التحميل المسبق (1..8) — الافتراضي 4
#RVC_PREFETCH_FACTOR=4

# torch.compile للمولّد والمميّز: الافتراضي 0 (eager — الأسرع للتدريب الصوتي).
# 1 = تفعيل (يحتاج إعادة ترجمة عند تغيّر الأشكال — جرّبه للحالات الخاصة فقط)
#RVC_TORCH_COMPILE=0

# المميّز متعدد المقاييس (MSD): فارغ = يتبع إعداد الجلسة (use_msd).
# 0 = تعطيل كلي
#RVC_MSD=

# تحسين (augmentation) بيانات التدريب: فارغ = يتبع إعداد الجلسة (augment).
# 1 = تفعيل قسري، 0 = تعطيل كلي
#RVC_AUGMENT=

# حقب الإحماء (warmup) الخطي لثبات الضبط الدقيق — 0 = تعطيل.
# الافتراضي: 1 (من إعداد الجلسة warmup_epochs)
#RVC_WARMUP_EPOCHS=1

# كسر الذيل الجيبي (cosine tail) لمعدل التعلم كنسبة من lr (0..1).
# 0 = اضمحلال أُسّي خالص (الافتراضي)
#RVC_COSINE_FRAC=0

# مهلة انتظار تفريغ خيط الإدخال/الإخراج عند نهاية التدريب بالثواني
# (كتابة كل نقاط التحقق المعلّقة) — الافتراضي 900
#RVC_IO_FLUSH_TIMEOUT=900


# ============================================================================
# 7) مقاييس التحقق وتقييم الجودة
# ============================================================================
# سقف عدد دفعات التحقق عند اختيار best model — الافتراضي 64
#RVC_MAX_VAL_BATCHES=64

# مقياس تشابه المتحدث (speaker similarity) أثناء التدريب: 1 = مفعّل
# (0/off/false/no للتعطيل وتوفير الحوسبة على الأجهزة الضعيفة)
#RVC_SPK_SIM=1

# مقياس دقة النغمة (F0) أثناء التدريب: 1 = مفعّل
#RVC_F0_EVAL=1


# ============================================================================
# 8) نشر النتائج إلى HuggingFace من التدريب
# (يستخدم RVC_HF_TOKEN أعلاه أو HF_TOKEN القياسي)
# ============================================================================
# عدد محاولات رفع الملفات — الافتراضي 3
#RVC_HF_UPLOAD_ATTEMPTS=3

# مهلة التراجع بين المحاولات بالثواني (5 ثم 10 ثم 20...) — الافتراضي 5
#RVC_HF_RETRY_BACKOFF=5

# مهلة إغلاق ناشر HF عند نهاية التدريب بالثواني — الافتراضي 300
#RVC_HF_CLOSE_TIMEOUT=300


# ============================================================================
# 9) النفق (Cloudflare Tunnel) والسجلات
# ============================================================================
# بدء نفق trycloudflare مع إقلاع الويب (مكافئ --tunnel).
# تذكير: تفعيل النفق يجعل المصادقة إلزامية تلقائيًا.
#RVC_TUNNEL_ENABLED=false

# مستوى السجلات: DEBUG | INFO | WARNING | ERROR
#RVC_LOG_LEVEL=INFO


# ============================================================================
# 10) إعادة توجيه المسارات
# ============================================================================
# إعادة توجيه الجذر الكامل للمشروع (نماذج/بيانات/تدريب/سجلات).
# حالة الاستخدام الأساسية: مجلد Google Drive في Colab، أو وحدة تخزين Docker
# (في حاوية Docker الرسمية: RVC_PLATFORM_ROOT=/data مضبوط مسبقًا).
# ملاحظة: logs/ و.tmp/ يتبعان الجذر دائمًا.
#RVC_PLATFORM_ROOT=

# إعادة توجيه مجلدات مفردة (مفيد لفصل الأقراص — كلها اختيارية):
#RVC_MODELS_DIR=        # افتراضيًا <root>/models
#RVC_ASSETS_DIR=        # افتراضيًا <root>/assets   (HuBERT، rmvpe، pretrained_v2)
#RVC_DATA_DIR=          # افتراضيًا <root>/data     (مجموعات البيانات والرفعات)
#RVC_RUNS_DIR=          # افتراضيًا <root>/runs     (جلسات التدريب)
#RVC_CACHE_DIR=         # افتراضيًا <root>/.cache

# مسار ملف إعداد YAML بديل عن configs/user.yaml
#RVC_PLATFORM_CONFIG=


# ============================================================================
# 11) مرجع سريع: متغيرات لا تُقرأ من .env — مستوى الشل/الدفتر فقط
# ============================================================================
# تُضبط هذه قبل تشغيل سكربتات التثبيت/الأدوات (تصدير في الشل أو خلية الدفتر)،
# ولا يمرّ عليها ملف .env:
#
#   IRAQI_VOICE_REPO=...      رابط fork بديل لسكربت تثبيت Colab/Ubuntu
#   MOUNT_DRIVE=1             تحميل Google Drive في مثبّت Colab (افتراضي 1)
#   DRIVE_DIR=RVC_Iraqi       اسم المجلد داخل MyDrive
#   COLAB_LOCAL_WORKSPACE=1   التدريب على /content المحلي + نسخ للـDrive (افتراضي 1)
#   SKIP_ASSETS=1             تخطّي تنزيل الأوزان المسبقة في المثبّت
#   RVC_DRIVE_ROOT=...        مسار مجلد Drive (يضبطه المثبّت تلقائيًا)
#   UV_NO_SYNC=1              منع uv من إعادة المزامنة وإرجاع عجلات CPU مكان GPU
#   EXPERIMENT=iraqi_voice    اسم التجربة لسكربت scripts/hf_auto_sync.py
#   HF_REPO=eng7mi/Iraqi-v2   مستودع النشر لسكربت hf_auto_sync.py (قديم)
#   COLAB_GPU                 للكشف عن Colab (للقراءة فقط — لا تضبطه يدويًا)
# ============================================================================
