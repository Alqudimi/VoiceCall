# ============================================================
# Iraqi Voice Studio — نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم الخاصة بك.
#   cp .env.example .env
# ملف .env لا يُرفع إلى git إطلاقًا (انظر .gitignore).
# ============================================================

# --- نموذج HuggingFace الافتراضي ---
# معرف المستودع (يدعم المستودعات الخاصة عند توفير التوكن)
RVC_HF_REPO=eng7mi/Iraqi-v3
# توكن الوصول من HuggingFace — مطلوب للمستودعات الخاصة
# أنشئه من: https://huggingface.co/settings/tokens
RVC_HF_TOKEN=
# رابط التنزيل الأساسي (اختياري — يُبنى تلقائيًا من RVC_HF_REPO إن تُرك فارغًا)
# مفيد للتوجيه إلى مرآة بديلة
RVC_HF_MODEL_URL=
# اسم النموذج المسجّل محليًا داخل models/
RVC_HF_LOCAL_NAME=iraqi_voice
# مسارات الملفات داخل المستودع (افتراضيات best/ لخط Iraqi-v3)
RVC_HF_MODEL_FILE=best/model.pth
RVC_HF_INDEX_FILE=best/index.index
# تنزيل تلقائي عند الإقلاع / تحميل تلقائي كنموذج افتراضي
RVC_HF_AUTO_DOWNLOAD=true
RVC_HF_AUTO_LOAD=true

# --- إعدادات عامة (اختيارية) ---
# جهاز الاستدلال: auto | cpu | cuda:0
#RVC_DEVICE=auto
# حجم كتلة البث اللحظي بالمللي ثانية (60..500)
#RVC_BLOCK_MS=160
# تفعيل مصادقة API
#RVC_AUTH_ENABLED=false
